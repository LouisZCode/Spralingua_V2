# Keep secrets out of image layers — inject them at runtime instead.
.env
.env.*
!.env.example

# The frontend ships as its own image (frontend/Dockerfile); keep it out of the
# backend build context entirely.
frontend/

# VCS / editor
.git
.gitignore
.idea
.vscode

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node (root has none; frontend excluded above)
node_modules/

# Runtime data — must not be baked into the image. Exclude only the
# per-session OUTPUT dir, NOT all of logs/: logs/ is also a Python package
# (logs/__init__.py, logs/session_logger.py) imported by pipeline/factory.py
# at startup, so a blanket logs/ ignore crashes the app with ModuleNotFoundError.
logs/conversations/
*.mp3
*.wav

# OS noise
.DS_Store
