# Spralingua v2 — backend environment.
# Copy to `.env` and fill in. The real `.env` is gitignored; never commit it.
# Everything here is a placeholder, not a real credential.

# --- Required ---

# Postgres. Locally use the +asyncpg form below. Managed hosts (Railway/Render/
# Neon/Supabase) hand you a plain postgresql:// — that's fine, the app normalizes
# the scheme to +asyncpg at startup (config/settings.py).
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/spralingua_db

# Deployment marker. Leave "dev" locally. Set to "production" (anything != "dev")
# in a deployed env — that makes a missing JWT_SECRET fail loud (auth/tokens.py).
APP_ENV=dev

# Speech-to-text (Deepgram).
DEEPGRAM_API_KEY=your-deepgram-key

# Text-to-speech (MiniMax).
MINIMAX_API_KEY=your-minimax-key
MINIMAX_GROUP_ID=your-minimax-group-id

# LLM (Cerebras via OpenRouter).
OPENROUTER_API_KEY=your-openrouter-key
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Google sign-in (AUTH-001) — same client id the frontend uses.
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
# HS256 secret for our session JWT. REQUIRED when APP_ENV != dev. Generate a long
# random value, e.g. `openssl rand -base64 48`.
JWT_SECRET=change-me-to-a-long-random-string
# JWT_EXPIRY_DAYS=7

# Browser origins allowed to call the HTTP API / open the demo socket
# (comma-separated). Set this to your deployed frontend origin in prod.
ALLOWED_ORIGINS=http://localhost:3000

# --- Optional ---

# Observability (Langfuse) — per-turn STT/LLM/TTS generations.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=
# LANGFUSE_TRACING_ENVIRONMENT=dev

# Pronunciation assessment (Azure Speech, PRON-001).
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=eastus

# Error reporting (Sentry, OBS-013). Absent -> sentry_sdk.init() is never
# called; the app boots and behaves identically to before this feature
# existed. Set SENTRY_DSN in any deployed environment to turn it on.
# SENTRY_DSN=
# Defaults to LANGFUSE_TRACING_ENVIRONMENT (itself defaulting to "dev") so
# Sentry and Langfuse agree on which deploy an event/trace came from.
# SENTRY_ENVIRONMENT=

# Public-demo guardrails (SEC-001). Defaults shown; override only to tune.
# DEMO_SESSION_TIMEOUT_S=180
# DEMO_MAX_CONCURRENT=25
# DEMO_PER_IP_CONCURRENT=2
# DEMO_PER_IP_NEW_PER_WINDOW=20
# DEMO_PER_IP_WINDOW_S=600
# DEMO_GLOBAL_NEW_PER_MIN=60
# SAY_MAX_CHARS=500
# SAY_PER_IP_INTERVAL_S=2
# RATE_LIMIT_EXEMPT_IPS=127.0.0.1,::1,localhost
