# Spralingua v2 — frontend environment.
# Copy to `.env.local` and fill in. NEXT_PUBLIC_* values are inlined at BUILD
# time, so they must be present before `npm run build` (or passed as Docker
# build args) — changing them later requires a rebuild.

# Backend origin the browser talks to. The WebSocket URL (ws/wss) is derived
# from this in src/lib/api.ts — use https:// in production so the socket becomes
# wss:// (browsers block ws:// from an https page).
NEXT_PUBLIC_API_URL=http://localhost:8765

# Google OAuth Web Client ID (same value as the backend's GOOGLE_CLIENT_ID).
# An empty value renders a no-op sign-in button, so this must be set.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
